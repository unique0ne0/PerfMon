    "codex-planning": { "adapter": "codex", "family": "codex", "model": "gpt-6.1-terra", "fallbackProfiles": [] },
    "gemini-planning": { "adapter": "antigravity", "family": "gemini", "model": "gemini-4-hydrogen-high", "fallbackProfiles": [] },
    "gemini-driver": { "adapter": "antigravity", "family": "gemini", "model": "gemini-4-hydrogen-medium", "fallbackProfiles": ["claude-driver", "codex-driver"] },
    "claude-driver": { "adapter": "claude", "family": "claude", "model": "claude-sonnet-5-5", "fallbackProfiles": ["codex-driver"] },
