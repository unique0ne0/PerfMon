    "claude-integration": { "adapter": "claude", "family": "claude", "model": "claude-sonnet-5-5", "fallbackProfiles": [] },
    "claude-integration-opus": { "adapter": "claude", "family": "claude", "model": "claude-opus-5-5", "fallbackProfiles": ["claude-integration"] },
    "codex-integration": { "adapter": "codex", "family": "codex", "model": "gpt-6.1-terra", "fallbackProfiles": [] },
    "opencode-planning": { "adapter": "opencode", "family": "deepseek", "model": "opencode/big-pickle", "fallbackProfiles": [] },
    "opencode-driver": { "adapter": "opencode", "family": "deepseek", "model": "opencode/big-pickle", "fallbackProfiles": ["codex-driver"] },
    "opencode-qa": { "adapter": "opencode", "family": "deepseek", "model": "opencode/big-pickle", "fallbackProfiles": [] },
    "opencode-integration": { "adapter": "opencode", "family": "deepseek", "model": "opencode/big-pickle", "fallbackProfiles": [] },
    "gemini-integration": { "adapter": "antigravity", "family": "gemini", "model": "gemini-4-hydrogen-high", "fallbackProfiles": [] }
  },
  "routes": {
    "claude-planned":      ["opencode-go/deepseek-v4.1-flash", "opencode-go/glm-5.3-flash", "opencode-go/mimo-v2.6-flash", "opencode/deepseek-v4.1-flash-free", "opencode/glm-5.3-flash-free", "opencode/big-pickle"],
    "independent-planned": ["opencode-go/deepseek-v4.1-flash", "opencode-go/glm-5.3-flash", "opencode-go/mimo-v2.6-flash", "opencode/deepseek-v4.1-flash-free", "opencode/glm-5.3-flash-free", "opencode/big-pickle"],
    "gemini-planned":      ["opencode/big-pickle"],
    "gemini-implementation": ["google/gemini-4-hydrogen"],
    "codex-implementation":  ["openai/gpt-6.1-terra"]
  },
  "plannerRouting": {
    "claude": { "implementationRoute": "independent-planned", "qaProfile": "gemini-qa", "integrationProfile": "claude-integration" },
    "codex": { "implementationRoute": "independent-planned", "qaProfile": "gemini-qa", "integrationProfile": "codex-integration" },
    "antigravity": { "implementationRoute": "independent-planned", "qaProfile": "codex-qa", "integrationProfile": "gemini-integration" },
    "opencode": { "implementationRoute": "independent-planned", "qaProfile": "gemini-qa", "integrationProfile": "claude-integration" },
    "gemini": { "implementationRoute": "gemini-implementation", "qaProfile": "codex-qa", "integrationProfile": "gemini-integration" }
  },
  "planningQuotaPolicy": {
    "enabled": true,
    "boundaryHour": 17,
    "hardCapPercent": 95,
    "dailyCapPercent": { "Monday": 16, "Tuesday": 32, "Wednesday": 46, "Thursday": 60, "Friday": 72, "Saturday": 84, "Sunday": 95 },
    "underCapProfile": "claude-planning",
    "overCapProfile": "codex-planning",
    "telemetryMaxAgeMinutes": 360,
    "probeEnabled": true,
    "probeMaxAgeMinutes": 10,
    "warnAtPercent": 93
  },
  "fallbackOn": ["provider_unavailable", "authentication", "quota"],
  "providerCooldown": { "quotaDefaultHours": 5, "repeatedQuotaHours": 24 },
  "rateLimit": { "opencode-free": { "maxCallsPerHour": 80 } }
}
